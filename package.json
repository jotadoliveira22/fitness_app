{
  "name": "fitness-app",
  "private": true,
  "version": "0.1.0",
  "description": "Health & Fitness SaaS MCP App — monorepo",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./apps/* run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "dev:mcp": "pnpm --filter @fitness-app/mcp-server dev"
  },
  "dependencies": {
    "@fitness-app/api": "workspace:*",
    "@supabase/supabase-js": "^2.45.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "dotenv": "^17.4.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.28"
    }
  }
}
