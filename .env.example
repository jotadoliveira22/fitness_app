# Proyecto Supabase (Configuración → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NUNCA exponer esta clave al cliente. Solo se usa en packages/api (backend).
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión directa a Postgres, solo para aplicar migraciones (supabase db push / CLI).
# Configuración → Database → Connection string (modo "URI").
SUPABASE_DB_URL=

NODE_ENV=development
